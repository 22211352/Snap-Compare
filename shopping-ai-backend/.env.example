APP_NAME=Shopping AI Assistant
ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shopping_ai
USE_MOCK_PROVIDER=true
USE_MOCK_VISION=true
USE_MOCK_PRODUCT=true
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=*

# Google Gemini Vision API. Set USE_MOCK_VISION=false to enable it.
VISION_API_KEY=
VISION_API_BASE_URL=https://generativelanguage.googleapis.com

# TODO: Replace with real JD Union API credentials.
JD_APP_KEY=
JD_APP_SECRET=
JD_API_BASE_URL=

# TODO: Replace with real PDD DuoDuoJinBao API credentials.
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_API_BASE_URL=

# TODO: Replace with real LLM API credentials.
LLM_API_KEY=
LLM_API_BASE_URL=
